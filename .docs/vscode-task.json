## 🧩 Part 4: TypeScript / MCP Blueprint (ZyntroAI MCP)
```typescript
// src/taskRegistry.ts
import fs from "fs/promises";
import { z } from "zod";

const TaskSchema = z.object({
  id: z.string(),
  title: z.string(),
  description: z.string().optional(),
  status: z.enum(["todo", "in_progress", "ready_review", "done", "cancelled"]),
  priority: z.enum(["low", "medium", "high", "critical"]).default("medium"),
  createdAt: z.string().datetime().optional(),
  updatedAt: z.string().datetime().optional(),
  due: z.string().date().nullable().optional(),
  tags: z.array(z.string()).default([]),
  relatedNotes: z.array(z.string()).default([]),
  automation: z.object({
    runCommand: z.string().nullable().optional(),
    cron: z.string().nullable().optional(),
    autoCreateVaultNote: z.boolean().default(true)
  }).default({})
});

const RegistrySchema = z.object({
  version: z.literal("1.0.0"),
  updatedAt: z.string().datetime().optional(),
  tasks: z.array(TaskSchema)
});

export async function loadRegistry(path = "tasks/task.json") {
  const raw = await fs.readFile(path, "utf8");
  return RegistrySchema.parse(JSON.parse(raw));
}

export async function saveRegistry(registry: unknown, path = "tasks/task.json") {
  await fs.writeFile(path, JSON.stringify(registry, null, 2));
}
Register to MCP:
server.registerTool("task_list", {
  description: "List ZyntroAI tasks from task.json registry",
  inputSchema: { status: z.string().optional() },
}, async ({ status }) => {
  const reg = await loadRegistry();
  const filtered = status ? reg.tasks.filter(t => t.status === status) : reg.tasks;
  return { content: [{ type: "text", text: JSON.stringify(filtered, null, 2) }] };
});

server.registerTool("task_update_status", {
  description: "Update task status in task.json",
  inputSchema: { id: z.string(), status: z.enum(["todo", "in_progress", "ready_review", "done", "cancelled"]) },
}, async ({ id, status }) => {
  const reg = await loadRegistry();
  const idx = reg.tasks.findIndex(t => t.id === id);
  if (idx < 0) throw new Error("Task not found");
  reg.tasks[idx].status = status;
  reg.tasks[idx].updatedAt = new Date().toISOString();
  reg.updatedAt = new Date().toISOString();
  await saveRegistry(reg);
  return { content: [{ type: "text", text: `✅ Updated ${id} → ${status}` }] };
});
