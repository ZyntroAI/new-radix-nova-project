tasks/schema.json
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZyntroAI Task Schema",
  "type": "object",
  "required": ["version", "tasks"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^zt-[0-9]{8}-[a-z0-9]{4}$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["todo", "in_progress", "ready_review", "done", "cancelled"]
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "default": "medium"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "due": { "type": "string", "format": "date", "nullable": true },
          "assignee": { "type": "string", "nullable": true },
          "tags": { "type": "array", "items": { "type": "string" } },
          "relatedNotes": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "automation": {
            "type": "object",
            "properties": {
              "runCommand": { "type": "string", "nullable": true },
              "cron": { "type": "string", "nullable": true },
              "autoCreateVaultNote": { "type": "boolean", "default": true }
            }
          }
        }
      }
    }
  }
}
