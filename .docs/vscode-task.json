name: Task Registry Validation
on:
  pull_request:
    branches: [main]
    paths:
      - "tasks/**"
jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v6
      - run: npm install -g ajv-cli jq
      - run: ajv validate -s tasks/schema.json -d tasks/task.json
      - run: ./scripts/zyntro-task.sh validate
