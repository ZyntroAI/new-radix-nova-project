🧩 Part 2: CLI Script (scripts/zyntro-task.sh) — เชื่อม task.json ↔ Obsidian
#!/usr/bin/env bash
set -euo pipefail

VAULT="${ZYNTRO_DOCS_ROOT:-$HOME/vaults/ZyntroAI-Docs}"
TASK_JSON="tasks/task.json"
DATE=$(date +%Y-%m-%d)

cmd_validate() {
  echo "🔍 Validating task.json"
  ajv validate -s tasks/schema.json -d "$TASK_JSON"
  echo "✅ Valid"
}

cmd_list() {
  local filter="${1:-}"
  if [ -n "$filter" ]; then
    jq ".tasks[] | select(.status == \"$filter\") | {id,title,status,due}" "$TASK_JSON"
  else
    jq ".tasks[] | {id,title,status,due}" "$TASK_JSON"
  fi
}

cmd_export_to_vault() {
  mkdir -p "$VAULT/Tasks"
  jq -c '.tasks[]' "$TASK_JSON" | while read -r task; do
    id=$(echo "$task" | jq -r '.id')
    title=$(echo "$task" | jq -r '.title')
    status=$(echo "$task" | jq -r '.status')
    priority=$(echo "$task" | jq -r '.priority')
    due=$(echo "$task" | jq -r '.due // ""')
    related=$(echo "$task" | jq -r '.relatedNotes | join(", ") // ""')
    note="$VAULT/Tasks/$id.md"

    cat > "$note" <<EOF
---
id: $id
type: task
status: $status
priority: $priority
due: $due
created: $DATE
tags: [zyntroai, task]
related: [$related]
---

# $title

## Description
$(echo "$task" | jq -r '.description')

## Automation
- Command: $(echo "$task" | jq -r '.automation.runCommand // "None"')
- Cron: $(echo "$task" | jq -r '.automation.cron // "None"')

## Progress
- [ ] Review
- [ ] Execute
- [ ] Update task.json status
EOF
    echo "✅ Exported: $note"
  done
}

cmd_update_status() {
  local id="$1"
  local newStatus="$2"
  if [ -z "$id" ] || [ -z "$newStatus" ]; then
    echo "Usage: $0 update-status <id> <todo|in_progress|ready_review|done|cancelled>"
    exit 1
  fi
  jq --arg id "$id" --arg status "$newStatus" --arg time "$(date -Iseconds)" \
    '.tasks[] |= if .id == $id then .status=$status | .updatedAt=$time else . end | .updatedAt=$time' \
    "$TASK_JSON" > tmp.json && mv tmp.json "$TASK_JSON"
  echo "✅ $id → $newStatus"
}

case "${1:-}" in
  validate) cmd_validate ;;
  list) cmd_list "${2:-}" ;;
  export-vault) cmd_export_to_vault ;;
  update-status) cmd_update_status "$2" "$3" ;;
  *)
    echo "Usage: $0 validate | list [status] | export-vault | update-status <id> <status>"
    ;;
esac
chmod +x scripts/zyntro-task.sh
alias zyntro-task="./scripts/zyntro-task.sh"
