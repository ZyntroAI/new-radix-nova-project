yaml  
name: Build & Publish Artifacts

on:
  push:
    branches: [ main, develop ]
    paths-ignore:
      - '**.md'
      - '.github/workflows/*.yml'
  pull_request:
    branches: [ main ]
    types: [ opened, synchronize, reopened ]
  workflow_dispatch:

env:
  NODE_VERSION: '20'
  ARTIFACTS_DIR: './dist'

jobs:
  build:
    name: Build Project
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Run build
        run: npm run build

      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        if: success()
        with:
          name: build-${{ github.sha }}
          path: ${{ env.ARTIFACTS_DIR }}/
          retention-days: 30
          if-no-files-found: error

  verify:
    name: Verify & Lint
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
    needs: build

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Run linting
        run: npm run lint

      - name: Run tests
        run: npm test

  release:
    name: Release Artifacts
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    needs: verify
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download build artifacts
        uses: actions/download-artifact@v4
        with:
          name: build-${{ github.sha }}
          path: ${{ env.ARTIFACTS_DIR }}/

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v1
        if: startsWith(github.ref, 'refs/tags/')
        with:
          files: ${{ env.ARTIFACTS_DIR }}/*
          generate_release_notes: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
 
 
 
 
📊 Workflow Structure
 
Job Trigger Purpose Depends On 
build Push / PR / Manual Compile code → output  dist/  artifacts — 
verify After build passes Lint + test the code  build  ✅ 
release Main branch only, on push Upload artifacts to GitHub Release  verify  ✅ 
 
 
 
✅ Key Features
 
- ✅  npm ci  instead of  npm install  — deterministic, faster, safer installs
- ✅ Cache for dependencies — speeds up repeated runs
- ✅ Separate jobs — build → verify → release (fail fast)
- ✅ Artifact retention — keeps builds for 30 days, auto-cleanup
- ✅ PR-safe — builds/tests PRs but doesn't publish releases
- ✅ Tag-triggered releases — create a tag → auto-creates GitHub Release
- ✅ Minimal permissions —  contents:read  on most jobs,  write  only where needed
 
 
 
🚀 How to Use
 
1. Create the file at:  .github/workflows/build-artifacts.yml 
2. Commit and push to  main  branch
3. Go to your repo → Actions tab → workflow will start automatically ✅
 
